<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sekcja podstawowych informacji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basic Information"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="@color/black"/>

        <!-- Nazwa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name:"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/eventNameET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:hint="Enter meal name"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Kategoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category:"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/mealCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/meal_categories"
            android:layout_marginBottom="16dp"/>

        <!-- Data i czas -->
        <TextView
            android:id="@+id/eventDateTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/eventTimeTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"/>

        <!-- Sekcja przepisu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"/>

        <MultiAutoCompleteTextView
            android:id="@+id/recipeET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter recipe steps..."
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:maxLines="8"
            android:layout_marginBottom="16dp"/>

        <!-- Sekcja składników -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"/>

        <!-- Dodawanie składników -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/ingredientNameET"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Ingredient name"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/addIngredientBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textSize="16sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/blue"
                android:textColor="@color/white"/>

            <Button
                android:id="@+id/scanProductBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan"
                android:textSize="16sp"
                android:drawableStart="@drawable/scan_icon"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/blue"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Wprowadzanie makroskładników -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <EditText
                android:id="@+id/caloriesET"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Calories"
                android:inputType="numberDecimal"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/proteinET"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Protein (g)"
                android:inputType="numberDecimal"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/carbsET"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Carbs (g)"
                android:inputType="numberDecimal"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/fatsET"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Fats (g)"
                android:inputType="numberDecimal"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Lista składników -->
        <ListView
            android:id="@+id/ingredientListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false"/>

        <!-- Przycisk zapisu -->
        <Button
            android:id="@+id/saveEventBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"
            android:textStyle="bold"
            android:layout_gravity="right"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="52dp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>